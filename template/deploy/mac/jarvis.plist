<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Serviço do macOS que mantém a ponte do Jarvis rodando (sobe no login e reinicia se cair).
     Troque PASTA_DO_JARVIS pelo caminho absoluto da sua pasta (ex.: /Users/voce/jarvis) e rode:
       cp deploy/mac/jarvis.plist ~/Library/LaunchAgents/dev.jarvis.ponte.plist
       launchctl load ~/Library/LaunchAgents/dev.jarvis.ponte.plist
     Log: dados/ponte.log. Parar: launchctl unload ~/Library/LaunchAgents/dev.jarvis.ponte.plist
     A pasta NÃO pode ficar em Mesa/Documentos/Downloads: o macOS bloqueia serviços em segundo plano ali. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.jarvis.ponte</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/env</string><string>python3</string><string>PASTA_DO_JARVIS/scripts/jarvis_bridge.py</string></array>
  <key>WorkingDirectory</key><string>PASTA_DO_JARVIS</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>PASTA_DO_JARVIS/dados/ponte.log</string>
  <key>StandardErrorPath</key><string>PASTA_DO_JARVIS/dados/ponte.log</string>
</dict>
</plist>
