# Copie para .env e preencha. Este arquivo NUNCA vai para o git.
JARVIS_NOME=Jarvis
# telegram | whatsapp-meta | whatsapp-twilio
CANAL=telegram
# gerado por: python3 scripts/jarvis_bridge.py --definir-senha
JARVIS_SENHA_HASH=

# Telegram (versão grátis) · docs/TELEGRAM.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (versão paga) · celular do dono com DDI, só números (ex.: 5511999998888)
WHATSAPP_DONO=
# Meta · docs/WHATSAPP-META.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_COTA=900
# Twilio · docs/WHATSAPP-TWILIO.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# ex.: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Servidor (versão paga): URL pública HTTPS que chega na ponte (Caddy ou túnel nomeado)
PUBLIC_URL=

# Instagram pelo Composio · docs/COMPOSIO.md
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=jarvis

# Hospedagem da mídia · docs/HOSPEDAGEM.md
# vercel | servidor
HOSPEDAGEM=vercel
BLOB_READ_WRITE_TOKEN=

# Tendências do Instagram (opcional) · docs/TENDENCIAS.md
META_TOKEN=
META_IG_ID=

# Claude no servidor (versão paga): um dos dois
# da sua assinatura: rode `claude setup-token` no seu computador
CLAUDE_CODE_OAUTH_TOKEN=
# ou pague por uso pela API
ANTHROPIC_API_KEY=
